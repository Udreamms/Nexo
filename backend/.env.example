NODE_ENV=development
PORT=4000

# Orígenes web permitidos por CORS, separados por coma. Las apps móviles no envían Origin y no lo necesitan.
CORS_ORIGINS=http://localhost:3000

# Firebase Admin
FIREBASE_PROJECT_ID=nexo-dev
# En Vercel: pega aquí el JSON completo de la cuenta de servicio (nunca lo subas al repositorio).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Solo desarrollo local con emuladores
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
